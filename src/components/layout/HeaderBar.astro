---
import { Image } from "astro:assets";
import monogramDark from "../../assets/brand/monogram-dark.svg";
import monogramLight from "../../assets/brand/monogram-light.svg";
import wordmarkDark from "../../assets/brand/wordmark-dark.png";
import wordmarkLight from "../../assets/brand/wordmark-light.png";
import type { Locale } from "../../i18n/locales";
import { pagePath, type PageKey } from "../../i18n/routes";
import { ui } from "../../i18n/ui";
import { whatsappLink } from "../../lib/links";
import { otherLocale, primaryNavItems } from "./navigation";

interface Props {
  locale: Locale;
  page: PageKey;
  /** The home page shows the wordmark; inner pages show the monogram. */
  logo: "wordmark" | "monogram";
  /** id of the mobile menu the burger button opens. */
  menuId: string;
}

const { locale, page, logo, menuId } = Astro.props;
const t = ui[locale];
const alternate = otherLocale(locale);

const logos =
  logo === "wordmark"
    ? {
        light: wordmarkLight,
        dark: wordmarkDark,
        class: "aspect-412/132 h-7 w-auto",
      }
    : { light: monogramLight, dark: monogramDark, class: "h-8.5 w-auto" };

// Colors follow the `data-tone` of the enclosing SiteHeader: light over dark backgrounds, dark over light ones.
const dot =
  "size-1.25 flex-none rounded-full bg-lilac group-data-[tone=dark]:bg-plum";
const burgerLine =
  "absolute left-1/2 h-px w-6 -translate-x-1/2 bg-current transition-[top,rotate] duration-500 ease-materia";
---

<a
  href={pagePath("home", locale)}
  aria-label={t.homeLinkLabel}
  class="inline-flex min-h-11 items-center"
>
  <Image
    src={logos.light}
    alt={t.logoAlt}
    class:list={[logos.class, "group-data-[tone=dark]:hidden"]}
    densities={[1, 2]}
    loading="eager"
  />
  <Image
    src={logos.dark}
    alt={t.logoAlt}
    class:list={[logos.class, "hidden group-data-[tone=dark]:block"]}
    densities={[1, 2]}
    loading="eager"
  />
</a>
{/* On mobile the links move into the menu; without JavaScript they stay here so the site remains navigable. */}
<nav
  aria-label={t.primaryNavLabel}
  class="flex w-full flex-wrap items-center gap-x-4 gap-y-0 text-15 max-md:in-[.js]:hidden md:w-auto md:gap-7"
>
  {primaryNavItems(locale).map((item) =>
    item.key === page ? (
      // The current page sits between two small dots, as in the design.
      <a
        href={item.href}
        aria-current="page"
        class="inline-flex items-center gap-2.5 py-3 font-medium"
      >
        <span aria-hidden="true" class={dot} />
        {item.label}
        <span aria-hidden="true" class={dot} />
      </a>
    ) : (
      <a href={item.href} class="py-3">
        {item.label}
      </a>
    ),
  )}
  <a href={pagePath(page, alternate)} hreflang={alternate} class="py-3">
    <span lang={alternate}>{t.languageSwitch.text}</span>
    <span class="sr-only"> · {t.languageSwitch.label}</span>
  </a>
  <a
    href={whatsappLink(locale, "contact")}
    target="_blank"
    rel="noopener noreferrer"
    class="box-content inline-flex min-h-11 items-center border border-cream/80 px-5 text-14 font-medium group-data-[tone=dark]:border-ink/70"
  >
    {t.writeToMe}
  </a>
</nav>
<button
  type="button"
  data-menu-toggle
  data-label-open={t.menu.open}
  data-label-close={t.menu.close}
  aria-label={t.menu.open}
  aria-expanded="false"
  aria-controls={menuId}
  class="relative -mr-2.5 hidden size-11 max-md:in-[.js]:block"
>
  {/* Two lines that cross into an X while the menu is open. */}
  <span
    aria-hidden="true"
    class:list={[
      burgerLine,
      "top-4.5 group-data-open:top-1/2 group-data-open:rotate-45",
    ]}
  ></span>
  <span
    aria-hidden="true"
    class:list={[
      burgerLine,
      "top-6.5 group-data-open:top-1/2 group-data-open:-rotate-45",
    ]}
  ></span>
</button>
