---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import wordmarkDark from "../../assets/brand/wordmark-dark.png";
import wordmarkLight from "../../assets/brand/wordmark-light.png";
import type { Locale } from "../../i18n/locales";
import { pagePath, type PageKey } from "../../i18n/routes";
import { ui } from "../../i18n/ui";
import { links, whatsappLink } from "../../lib/links";
import { displayText, labelText } from "../../lib/typography";
import Grid from "./Grid.astro";

type Tone = "light" | "dark";

interface Props {
  locale: Locale;
  tone: Tone;
  /** Link to the next page in the reading order, shown above the footer. */
  next?: { page: PageKey; title: string };
  /** Inner pages align footer items to the start on mobile; the home page stretches them. */
  mobileAlign?: "start" | "stretch";
}

const { locale, tone, next, mobileAlign = "stretch" } = Astro.props;
const t = ui[locale];

const toneClasses: Record<
  Tone,
  { text: string; next: string; logo: ImageMetadata }
> = {
  light: {
    text: "text-cream",
    next: "border-cream/32 text-cream",
    logo: wordmarkLight,
  },
  dark: {
    text: "text-ink-plum",
    next: "border-ink/25 text-ink",
    logo: wordmarkDark,
  },
};
const tones = toneClasses[tone];
const itemAlign =
  mobileAlign === "start" ? "justify-self-start md:justify-self-auto" : "";

const footerLinks = [
  {
    label: t.footerLinks.whatsapp,
    href: whatsappLink(locale, "contact"),
    external: true,
  },
  { label: t.footerLinks.instagram, href: links.instagram, external: true },
  { label: t.footerLinks.substack, href: links.substack, external: true },
  { label: t.footerLinks.legal, href: links.legal },
  { label: t.footerLinks.privacy, href: links.privacy },
];
---

<Grid as="footer" class="items-end gap-y-6">
  {next && (
    <a
      href={pagePath(next.page, locale)}
      class:list={[
        "col-span-full mb-10 flex items-baseline justify-between gap-6 border-t pt-3.5",
        tones.next,
        itemAlign,
      ]}
    >
      <span class={labelText}>{t.next}</span>
      <span class:list={[displayText, "text-40 leading-100"]}>
        {next.title} →
      </span>
    </a>
  )}
  <Image
    src={tones.logo}
    alt={t.logoAlt}
    widths={[160, 320]}
    sizes="160px"
    class:list={[
      "col-span-full aspect-412/132 h-auto w-full max-w-40 md:col-span-2 md:col-start-1",
      itemAlign,
    ]}
  />
  <p
    class:list={[
      "col-span-full m-0 font-display text-20 font-light md:col-span-4 md:col-start-4",
      tones.text,
      itemAlign,
    ]}
  >
    {t.tagline}
  </p>
  <nav
    aria-label={t.footerNavLabel}
    class:list={[
      "col-span-full flex flex-wrap justify-end gap-x-5 md:col-span-5 md:col-start-8",
      labelText,
      tones.text,
      itemAlign,
    ]}
  >
    {footerLinks.map((link) => (
      <a
        href={link.href}
        target={"external" in link ? "_blank" : undefined}
        rel={"external" in link ? "noopener noreferrer" : undefined}
        class="py-3"
      >
        {link.label}
      </a>
    ))}
  </nav>
</Grid>
