---
import type { Locale } from "../../i18n/locales";
import type { PageKey } from "../../i18n/routes";
import HeaderBar from "./HeaderBar.astro";

interface Props {
  locale: Locale;
  page: PageKey;
  /** Text color at the top of the page: light on the dark heroes, dark on Sobre mí. */
  tone: "light" | "dark";
  logo: "wordmark" | "monogram";
  /** Distance from the top of the screen to the header content. */
  class?: string;
  /**
   * Inner pages lay their hero out below the header: an invisible copy keeps that space,
   * so the hero looks exactly as designed while the real header floats above.
   */
  reserveSpace?: boolean;
}

const {
  locale,
  page,
  tone,
  logo,
  class: className,
  reserveSpace = false,
} = Astro.props;
const layout =
  "flex flex-wrap items-center justify-between gap-x-3 gap-y-1 px-5 md:gap-y-3 md:px-12";
---

{/*
  Always visible at the top of the screen as glass: a blur over the page, with no fill.
  It starts in the page's own color and switches to light or dark text depending on the
  section beneath it, so it stays readable everywhere.
*/}
<header
  data-site-header
  data-tone={tone}
  class:list={[
    "group fixed inset-x-0 top-0 z-40 pb-3 text-cream backdrop-blur-md transition-colors duration-300 data-[tone=dark]:text-ink",
    layout,
    className,
  ]}
>
  <HeaderBar locale={locale} page={page} logo={logo} />
</header>
{reserveSpace && (
  <div aria-hidden="true" inert class:list={["invisible pt-2", layout]}>
    <HeaderBar locale={locale} page={page} logo={logo} />
  </div>
)}

<script>
  import { followBackground } from "./header-tone";

  const header = document.querySelector<HTMLElement>("[data-site-header]");
  if (header) followBackground(header);
</script>
