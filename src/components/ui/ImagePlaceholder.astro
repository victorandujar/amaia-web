---
import { labelText } from "../../lib/typography";

interface Props {
  /** Accessible description of the picture that will fill this space. */
  label: string;
  tag: string;
  description: string;
  as?: "div" | "span";
  class?: string;
  tagClass?: string;
  descriptionClass?: string;
}

const {
  label,
  tag,
  description,
  as: Tag = "div",
  class: className,
  tagClass,
  descriptionClass,
} = Astro.props;
---

{/* The design keeps these boxes until the final photographs are chosen. */}
<Tag
  role="img"
  aria-label={label}
  class:list={["flex w-full flex-col justify-between", className]}
>
  <span class:list={[labelText, tagClass]}>{tag}</span>
  <span class={descriptionClass}>{description}</span>
</Tag>
