---
import type { RichText } from "../../lib/rich-text";

interface Props {
  text: RichText;
  /** Lets a page drop the forced line breaks on some screens. */
  brClass?: string;
}

const { text, brClass } = Astro.props;
---

{text.map((segment) => {
  if (typeof segment === "string") return segment;
  if ("em" in segment) return <span class="italic">{segment.em}</span>;
  return <br class={brClass} />;
})}
