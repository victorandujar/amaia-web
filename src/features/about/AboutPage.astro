---
import { Image } from "astro:assets";
import portraitImage from "../../assets/images/about-hero-portrait.jpg";
import Grid from "../../components/layout/Grid.astro";
import SiteFooter from "../../components/layout/SiteFooter.astro";
import InnerHero from "../../components/sections/InnerHero.astro";
import Button from "../../components/ui/Button.astro";
import RichText from "../../components/ui/RichText.astro";
import type { Locale } from "../../i18n/locales";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { whatsappLink } from "../../lib/links";
import { reveal } from "../../lib/motion";
import { displayText, labelText } from "../../lib/typography";
import ChaptersSection from "./ChaptersSection.astro";
import MultiplicitySection from "./MultiplicitySection.astro";
import SelfPortraitSection from "./SelfPortraitSection.astro";
import { aboutContent } from "./about.content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { meta, hero, closing } = aboutContent[locale];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  locale={locale}
  class="bg-stone"
>
  <main class="flex min-h-screen w-full flex-col bg-stone text-ink">
    <InnerHero
      locale={locale}
      page="about"
      tone="dark"
      title={hero.title}
      startWord={hero.startWord}
      endWord={hero.endWord}
      class="bg-stone text-ink md:gap-14"
      wordsClass="text-64 md:text-128"
      startWordClass="-mt-[0.14em] text-aubergine"
      endWordClass="text-plum italic"
    >
      <Image
        src={portraitImage}
        alt={hero.portraitAlt}
        widths={[432, 864, 1200]}
        sizes="(max-width: 760px) 78vw, 432px"
        loading="eager"
        class="block aspect-3/4 w-full object-cover"
      />
      <figcaption
        class:list={[
          "absolute top-full left-0 mt-3 font-sans whitespace-nowrap text-ink-soft",
          labelText,
        ]}
      >
        {hero.caption}
      </figcaption>
    </InnerHero>
    <SelfPortraitSection locale={locale} />
    <ChaptersSection locale={locale} />
    <MultiplicitySection locale={locale} />
    <section
      id="cierre"
      class="flex flex-1 flex-col justify-between gap-30 bg-lavender py-18 text-ink md:min-h-180 md:pt-50 md:pb-12"
    >
      <Grid startOnMobile class="items-start gap-y-12">
        <p
          lang="en"
          data-reveal
          class:list={[
            "col-span-full m-0 text-52 leading-098 text-aubergine md:col-span-11 md:col-start-1 md:text-112 md:leading-096",
            displayText,
            reveal,
          ]}
        >
          <RichText text={closing.quote} />
        </p>
        <div
          data-reveal
          class:list={[
            "col-span-full flex flex-col gap-4 md:col-span-5 md:col-start-8",
            reveal,
            "delay-200",
          ]}
        >
          <h2 class="m-0 font-display text-28 leading-112 font-light tracking-snug md:text-32">
            {closing.title}
          </h2>
          <Button
            href={whatsappLink(locale, "contact")}
            variant="ink"
            external
            class="mt-3"
          >
            {closing.cta}
          </Button>
        </div>
      </Grid>
      <SiteFooter
        locale={locale}
        tone="dark"
        next={{ page: "studio", title: closing.next }}
        mobileAlign="start"
      />
    </section>
  </main>
</BaseLayout>
