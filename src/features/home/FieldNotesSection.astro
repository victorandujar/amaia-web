---
import Grid from "../../components/layout/Grid.astro";
import ImagePlaceholder from "../../components/ui/ImagePlaceholder.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import UnderlineLink from "../../components/ui/UnderlineLink.astro";
import type { Locale } from "../../i18n/locales";
import { links } from "../../lib/links";
import { reveal } from "../../lib/motion";
import { displayText, labelText } from "../../lib/typography";
import { homeContent } from "./home.content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { fieldNotes } = homeContent[locale];
const placeholderColors = ["bg-mist-sand", "bg-mist-lilac", "bg-mist-stone"];
const noteDelays = ["delay-0", "delay-150", "delay-300"];
---

<section class="bg-linen py-18 text-ink md:min-h-210 md:pt-30 md:pb-32">
  <Grid class="items-end gap-y-12">
    <SectionLabel class="col-span-full border-ink/25 text-ink-soft" />
    <h2
      data-reveal
      class:list={[
        "col-span-full m-0 self-baseline-last text-30 leading-100 md:col-span-6 md:col-start-1 md:text-64",
        displayText,
        reveal,
      ]}
    >
      {fieldNotes.title}
    </h2>
    <p
      data-reveal
      class:list={[
        "col-span-full m-0 self-baseline-last text-left text-17 leading-150 text-ink-soft md:col-span-6 md:col-start-7 md:text-right md:text-18",
        reveal,
      ]}
    >
      {fieldNotes.intro}
    </p>
    <div class="col-span-full grid grid-cols-1 gap-x-6 gap-y-9 md:grid-cols-3 md:gap-y-0">
      {fieldNotes.notes.map((note, index) => (
        <a
          href={links.fieldNotes}
          data-reveal
          class:list={["flex flex-col gap-3.5", reveal, noteDelays[index]]}
        >
          <ImagePlaceholder
            as="span"
            label={note.label}
            tag={note.tag}
            description={note.description}
            class:list={["aspect-video p-5", placeholderColors[index]]}
            tagClass="text-ink-soft"
            descriptionClass="text-15 leading-140 text-ink"
          />
          <span class:list={["text-ink-soft", labelText]}>{note.number}</span>
          <span class="font-display text-27 leading-115 font-light tracking-snug">
            {note.title}
          </span>
        </a>
      ))}
    </div>
    <UnderlineLink
      href={links.fieldNotes}
      rule="ink"
      class="col-span-full justify-self-start md:col-span-4 md:col-start-1"
    >
      {fieldNotes.cta}
    </UnderlineLink>
  </Grid>
</section>
