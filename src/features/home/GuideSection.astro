---
import { Image } from "astro:assets";
import portraitImage from "../../assets/images/home-portrait-bouquet.jpg";
import Grid from "../../components/layout/Grid.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import UnderlineLink from "../../components/ui/UnderlineLink.astro";
import type { Locale } from "../../i18n/locales";
import { pagePath } from "../../i18n/routes";
import { reveal } from "../../lib/motion";
import { displayText } from "../../lib/typography";
import { homeContent } from "./home.content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { guide } = homeContent[locale];
---

<section
  id="quien"
  class="bg-lavender py-18 text-ink md:min-h-235 md:pt-30 md:pb-32"
>
  <Grid class="items-end gap-y-12">
    <SectionLabel
      text={guide.label}
      class="col-span-full border-ink/25 text-ink-soft"
    />
    <div
      data-reveal
      class:list={[
        "col-span-full flex flex-col gap-7 md:col-span-5 md:col-start-1",
        reveal,
      ]}
    >
      <h2 class:list={["m-0 text-30 leading-104 md:text-52", displayText]}>
        {guide.title}
      </h2>
      <p class="m-0 text-17 leading-160 text-ink-soft md:text-18">
        {guide.body}
      </p>
      <UnderlineLink href={pagePath("about", locale)} rule="ink">
        {guide.cta}
      </UnderlineLink>
    </div>
    <Image
      data-reveal
      src={portraitImage}
      alt={guide.portraitAlt}
      widths={[480, 800, 1200]}
      sizes="(max-width: 760px) 100vw, 40vw"
      class:list={[
        "col-span-full block aspect-4/5 h-auto w-full object-cover md:col-span-5 md:col-start-8",
        reveal,
      ]}
    />
  </Grid>
</section>
