---
import { Image } from "astro:assets";
import heroImage from "../../assets/images/home-hero-tulips.jpg";
import Grid from "../../components/layout/Grid.astro";
import SiteHeader from "../../components/layout/SiteHeader.astro";
import type { Locale } from "../../i18n/locales";
import { reveal } from "../../lib/motion";
import { labelText } from "../../lib/typography";
import IntroCurtain from "./IntroCurtain.astro";
import { homeContent } from "./home.content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { hero } = homeContent[locale];
// While the intro plays, the hero copy waits for the curtain to dissolve.
const heroReveal = [reveal, "in-[.intro]:delay-2200"];
---

<section class="relative h-200 overflow-hidden bg-night text-cream md:h-220">
  <Image
    src={heroImage}
    alt={hero.imageAlt}
    widths={[768, 1280, 1562]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 size-full object-cover object-[50%_40%]"
  />
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-linear-to-b/srgb from-shade/40 to-shade/0"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[52%] bg-linear-to-t/srgb from-shade/62 to-shade/0"
  ></div>
  <SiteHeader
    locale={locale}
    page="home"
    tone="light"
    logo="wordmark"
    class="absolute inset-x-0 top-3 md:top-6"
  />
  <Grid class="absolute inset-x-0 bottom-9 items-end gap-y-10">
    <h1
      data-reveal
      class:list={[
        "col-span-full m-0 font-display text-54 leading-098 font-light tracking-snug md:col-span-8 md:col-start-1 md:text-128 md:leading-092",
        heroReveal,
      ]}
    >
      <span class="italic">{hero.titleItalic}</span>
      <br />
      {hero.titleRest}
    </h1>
    <div
      data-reveal
      class:list={[
        "col-span-full flex flex-col gap-6 pb-2.5 md:col-span-4 md:col-start-9",
        heroReveal,
        "delay-200",
      ]}
    >
      <p class="m-0 text-17 leading-155 text-cream">{hero.lead}</p>
    </div>
    <div
      data-reveal
      class:list={[
        "col-span-full flex flex-wrap justify-start gap-x-4.5 gap-y-1.5 border-t border-cream/40 pt-3.5 text-cream/92 md:justify-between md:gap-x-6 md:gap-y-3",
        labelText,
        heroReveal,
        "delay-400",
      ]}
    >
      {hero.meta.map((item) => (
        <span lang={item.lang}>{item.text}</span>
      ))}
    </div>
  </Grid>
  <IntroCurtain />
</section>
