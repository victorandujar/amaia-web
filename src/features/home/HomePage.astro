---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Locale } from "../../i18n/locales";
import BridgeSection from "./BridgeSection.astro";
import ClosingSection from "./ClosingSection.astro";
import FieldNotesSection from "./FieldNotesSection.astro";
import GestationSection from "./GestationSection.astro";
import GuideSection from "./GuideSection.astro";
import HomeHero from "./HomeHero.astro";
import HousesSection from "./HousesSection.astro";
import PhilosophySection from "./PhilosophySection.astro";
import { homeContent } from "./home.content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { meta } = homeContent[locale];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  locale={locale}
  class="bg-ivory"
>
  <main class="w-full bg-ivory text-ink">
    <HomeHero locale={locale} />
    <GestationSection locale={locale} />
    <BridgeSection locale={locale} />
    <HousesSection locale={locale} />
    <PhilosophySection locale={locale} />
    <GuideSection locale={locale} />
    <FieldNotesSection locale={locale} />
    <ClosingSection locale={locale} />
  </main>
</BaseLayout>
