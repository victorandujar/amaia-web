---
import ritualsImage from "../../assets/images/home-rituals-tea.jpg";
import studioImage from "../../assets/images/home-studio-laptop.jpg";
import type { Locale } from "../../i18n/locales";
import { pagePath } from "../../i18n/routes";
import HouseCard from "./HouseCard.astro";
import { homeContent } from "./home.content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { studio, rituals } = homeContent[locale];
---

{/* Each half's color bleeds to its edge of the screen while the cards stay within the page width. */}
<section
  id="casas"
  class="text-cream md:bg-linear-to-r md:from-eucalyptus md:from-50% md:to-aubergine md:to-50%"
>
  <div class="mx-auto grid max-w-page grid-cols-1 md:grid-cols-2">
    <HouseCard
      id="studio"
      house={studio}
      image={studioImage}
      href={pagePath("studio", locale)}
      class="bg-eucalyptus"
    />
    <HouseCard
      id="rituals"
      house={rituals}
      image={ritualsImage}
      href={pagePath("rituals", locale)}
      class="bg-aubergine"
    />
  </div>
</section>
