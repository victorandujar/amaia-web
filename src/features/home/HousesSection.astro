---
import ritualsImage from "../../assets/images/home-rituals-tea.jpg";
import studioImage from "../../assets/images/home-studio-laptop.jpg";
import type { Locale } from "../../i18n/locales";
import { pagePath } from "../../i18n/routes";
import HouseCard from "./HouseCard.astro";
import { homeContent } from "./home.content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { studio, rituals } = homeContent[locale];
---

<section id="casas" class="grid grid-cols-1 text-cream md:grid-cols-2">
  <HouseCard
    id="studio"
    house={studio}
    image={studioImage}
    href={pagePath("studio", locale)}
    class="bg-eucalyptus"
  />
  <HouseCard
    id="rituals"
    house={rituals}
    image={ritualsImage}
    href={pagePath("rituals", locale)}
    class="bg-aubergine"
  />
</section>
