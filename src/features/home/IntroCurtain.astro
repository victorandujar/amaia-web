---
import { getImage } from "astro:assets";
import wordmarkLight from "../../assets/brand/wordmark-light.png";

const logo = await getImage({ src: wordmarkLight, format: "png" });
---

{/*
  The site's entrance: a plum curtain over the whole screen with the wordmark, which then dissolves
  cell by cell to reveal the home page. It plays on every load from the top of the page, and the page
  can't be scrolled or used until it ends. Skipped with reduced motion, as in the design.
*/}
<script is:inline>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const root = document.documentElement;
    root.classList.add("intro");
    history.scrollRestoration = "manual";
    window.scrollTo(0, 0);
    // Safety net: never leave the page locked if the animation script fails to run.
    setTimeout(() => root.classList.remove("intro"), 5000);
  }
</script>
<div
  data-intro
  aria-hidden="true"
  class="fixed inset-0 z-50 hidden bg-aubergine in-[.intro]:block"
>
  <canvas class="absolute inset-0 size-full"></canvas>
  <img
    src={logo.src}
    alt=""
    width="330"
    height="106"
    class="absolute top-1/2 left-1/2 h-26.5 w-82.5 max-w-none -translate-1/2 opacity-0 max-md:scale-80"
  />
</div>

<script>
  import { playIntro } from "./intro-curtain";

  const curtain = document.querySelector<HTMLElement>("[data-intro]");
  if (curtain && document.documentElement.classList.contains("intro")) {
    playIntro(curtain);
  }
</script>
