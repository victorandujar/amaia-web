---
import { Image } from "astro:assets";
import altarImage from "../../assets/images/manifesto-altar-writing.jpg";
import pondImage from "../../assets/images/manifesto-blue-lotus-pond.jpg";
import handImage from "../../assets/images/manifesto-hand-light.jpg";
import lotusImage from "../../assets/images/manifesto-lotus-cacao.jpg";
import drawingImage from "../../assets/images/manifesto-pastel-drawing.jpg";
import Grid from "../../components/layout/Grid.astro";
import SiteFooter from "../../components/layout/SiteFooter.astro";
import SiteHeader from "../../components/layout/SiteHeader.astro";
import Button from "../../components/ui/Button.astro";
import RichText from "../../components/ui/RichText.astro";
import type { Locale } from "../../i18n/locales";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { whatsappLink } from "../../lib/links";
import { materia, reveal } from "../../lib/motion";
import { displayText, labelText } from "../../lib/typography";
import { manifestoContent } from "./manifesto.content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { meta, title, opening, index, figures, reenchant, closing } =
  manifestoContent[locale];

const small = "m-0 text-13 leading-155";
const caption = "text-13 leading-150 text-ink-mute";
const muteLabel = ["m-0 text-ink-mute", labelText];
const section = "py-13 md:pt-50 md:pb-0";
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  locale={locale}
  page="manifesto"
  image={{ src: handImage, alt: opening.imageAlt }}
  class="bg-stone"
>
  <main class="flex min-h-screen w-full flex-col bg-stone text-ink">
    <SiteHeader
      locale={locale}
      page="manifesto"
      tone="dark"
      logo="monogram"
      class="pt-6"
      reserveSpace="pt-6"
    />
    <h1 class="sr-only">{title}</h1>

    <section id="apertura" class="py-13 md:pt-26 md:pb-0">
      <Grid startOnMobile class="items-start gap-y-10">
        <figure
          data-reveal
          class:list={[
            "col-span-full m-0 w-full max-w-[78%] md:col-span-5 md:col-start-2 md:max-w-126 md:justify-self-start",
            materia,
            "delay-300",
          ]}
        >
          <Image
            src={handImage}
            alt={opening.imageAlt}
            widths={[400, 800, 1008]}
            sizes="(max-width: 760px) 78vw, 504px"
            loading="eager"
            fetchpriority="high"
            class="block aspect-4/5 w-full object-cover"
          />
        </figure>
        <div
          data-reveal
          class:list={[
            "col-span-full flex flex-col gap-4.5 md:col-span-3 md:col-start-9",
            reveal,
            "delay-200",
          ]}
        >
          <p class:list={["m-0 text-plum", labelText]}>{opening.label}</p>
          <p class="m-0 font-display text-26 leading-120 font-light tracking-snug">
            {opening.statement}
          </p>
          {opening.paragraphs.map((paragraph) => (
            <p class={small}>{paragraph}</p>
          ))}
          <p class:list={[muteLabel, "mt-7"]}>{opening.discoveriesLabel}</p>
          <div class="flex flex-col gap-5.5">
            {opening.discoveries.map((discovery) => (
              <p class={small}>{discovery}</p>
            ))}
          </div>
        </div>
      </Grid>
    </section>

    <section id="indice" class="py-13 md:pt-30 md:pb-0">
      <Grid startOnMobile class="items-start gap-y-8">
        <div
          data-reveal
          class:list={[
            "col-span-full flex flex-col gap-3 md:col-span-3 md:col-start-1",
            reveal,
          ]}
        >
          {index.paragraphs.map((paragraph) => (
            <p class={small}>{paragraph}</p>
          ))}
        </div>
        <ul
          data-reveal
          class:list={[
            "col-span-full m-0 flex list-none flex-col gap-1 p-0 leading-160 md:col-span-2 md:col-start-4",
            labelText,
            reveal,
            "delay-150",
          ]}
        >
          {index.words.map((word) => (
            <li>{word}</li>
          ))}
        </ul>
        <figure
          data-reveal
          class:list={[
            "col-span-full m-0 flex w-full flex-col gap-3 max-md:justify-self-stretch md:col-span-3 md:col-start-6",
            reveal,
            "delay-300",
          ]}
        >
          <Image
            src={altarImage}
            alt={index.altar.alt}
            widths={[380, 760]}
            sizes="(max-width: 760px) 100vw, 324px"
            class="block aspect-[1/1.12] w-full object-cover"
          />
          <figcaption class={caption}>{index.altar.caption}</figcaption>
        </figure>
      </Grid>
    </section>

    <section id="figuras" class={section}>
      <Grid startOnMobile class="items-end gap-y-8">
        <figure
          data-reveal
          class:list={[
            "col-span-full m-0 flex w-full flex-col gap-3 max-md:justify-self-stretch md:col-span-3 md:col-start-1 md:h-110 md:w-106.25",
            reveal,
          ]}
        >
          <Image
            src={drawingImage}
            alt={figures.drawing.alt}
            widths={[425, 760]}
            sizes="(max-width: 760px) 100vw, 425px"
            class="block aspect-4/3 w-full object-cover"
          />
          <figcaption class:list={["max-w-65", caption]}>
            {figures.drawing.caption}
          </figcaption>
        </figure>
        <figure
          data-reveal
          class:list={[
            "col-span-full m-0 w-full max-md:justify-self-stretch md:col-span-7 md:col-start-6",
            reveal,
            "delay-200",
          ]}
        >
          <Image
            src={pondImage}
            alt={figures.pondAlt}
            widths={[480, 800, 1179]}
            sizes="(max-width: 760px) 100vw, 55vw"
            class="block aspect-square w-full object-cover"
          />
        </figure>
      </Grid>
    </section>

    <section id="texto" class={section}>
      <Grid startOnMobile class="items-start gap-y-10">
        <p
          class:list={[muteLabel, "col-span-full md:col-span-3 md:col-start-1"]}
        >
          {reenchant.label}
        </p>
        <div
          data-reveal
          class:list={[
            "col-span-full flex flex-col gap-5 md:col-span-5 md:col-start-4",
            reveal,
          ]}
        >
          <p
            class:list={[
              "m-0 mb-3 text-28 leading-110 md:text-40",
              displayText,
            ]}
          >
            <RichText text={reenchant.title} />
          </p>
          {reenchant.paragraphs.map((paragraph) => (
            <p class="m-0 text-17 leading-165 md:text-16">{paragraph}</p>
          ))}
        </div>
        <figure
          data-reveal
          class:list={[
            "col-span-full m-0 flex w-full flex-col gap-3 max-md:justify-self-stretch md:col-span-3 md:col-start-10",
            reveal,
            "delay-200",
          ]}
        >
          <Image
            src={lotusImage}
            alt={reenchant.lotus.alt}
            widths={[380, 760]}
            sizes="(max-width: 760px) 100vw, 324px"
            class="block aspect-3/4 w-full object-cover"
          />
          <figcaption class={caption}>{reenchant.lotus.caption}</figcaption>
        </figure>
      </Grid>
    </section>

    <section
      id="cierre"
      class="flex flex-1 flex-col justify-between gap-16 bg-stone py-13 text-ink md:min-h-160 md:gap-40 md:pt-60 md:pb-12"
    >
      <Grid startOnMobile class="items-end gap-y-10">
        <p
          data-reveal
          class:list={[
            "col-span-full m-0 text-40 leading-104 text-aubergine md:col-span-8 md:col-start-1 md:text-72 md:leading-100",
            displayText,
            reveal,
          ]}
        >
          <RichText text={closing.statement} />
        </p>
        <div
          data-reveal
          class:list={[
            "col-span-full flex flex-col gap-4 md:col-span-3 md:col-start-10",
            reveal,
            "delay-200",
          ]}
        >
          <p class={small}>{closing.body}</p>
          <Button href={whatsappLink(locale, "contact")} variant="ink" external>
            {closing.cta}
          </Button>
        </div>
      </Grid>
      <SiteFooter
        locale={locale}
        tone="dark"
        next={{ page: "about", title: closing.next }}
        mobileAlign="start"
        leftOnMobile
      />
    </section>
  </main>
</BaseLayout>
