---
import Grid from "../../components/layout/Grid.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import type { Locale } from "../../i18n/locales";
import { reveal } from "../../lib/motion";
import { displayText } from "../../lib/typography";
import { ritualsContent } from "./rituals.content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { intro } = ritualsContent[locale];
---

<section id="intro" class="bg-lavender py-18 text-ink md:pt-26 md:pb-24">
  <Grid startOnMobile class="items-end gap-y-10">
    <SectionLabel class="col-span-full border-ink/25 text-ink-soft" />
    <h2
      data-reveal
      class:list={[
        "col-span-full m-0 text-40 leading-104 md:col-span-8 md:col-start-1 md:text-96 md:leading-095",
        displayText,
        reveal,
      ]}
    >
      {intro.title}
    </h2>
    <div
      data-reveal
      class:list={[
        "col-span-full flex flex-col gap-5 pb-2.5 md:col-span-4 md:col-start-9",
        reveal,
        "delay-200",
      ]}
    >
      <p class="m-0 font-display text-17 leading-130 font-light tracking-snug md:text-24">
        {intro.lead}
      </p>
    </div>
  </Grid>
</section>
