---
import Grid from "../../components/layout/Grid.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import type { Locale } from "../../i18n/locales";
import { reveal } from "../../lib/motion";
import { displayText } from "../../lib/typography";
import { ritualsContent } from "./rituals.content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { languages } = ritualsContent[locale];
const itemDelays = ["delay-0", "delay-150", "delay-300"];
---

<section id="lenguajes" class="bg-lavender py-18 text-ink md:py-26">
  <Grid startOnMobile class="items-end gap-y-10">
    <SectionLabel class="col-span-full border-ink/25 text-ink-soft" />
    <h2
      data-reveal
      class:list={[
        "col-span-full m-0 text-40 leading-104 md:col-span-7 md:col-start-1 md:text-72 md:leading-098",
        displayText,
        reveal,
      ]}
    >
      {languages.title}
    </h2>
    <p
      data-reveal
      class:list={[
        "col-span-full m-0 text-17 leading-160 md:col-span-5 md:col-start-8 md:text-18",
        reveal,
      ]}
    >
      {languages.body}
    </p>
    <div class="col-span-full mt-4 grid grid-cols-1 gap-x-6 gap-y-8 md:grid-cols-3 md:gap-y-0">
      {languages.items.map((item, index) => (
        <div
          data-reveal
          class:list={[
            "flex flex-col gap-3 border-t border-ink/25 pt-4.5",
            reveal,
            itemDelays[index],
          ]}
        >
          <span class="font-display text-26 leading-112 font-light tracking-snug">
            {item.title}
          </span>
          <span class="text-16 leading-155 text-ink-soft">{item.body}</span>
        </div>
      ))}
    </div>
  </Grid>
</section>
