---
import Grid from "../../components/layout/Grid.astro";
import ServiceCard from "../../components/sections/ServiceCard.astro";
import Testimonial from "../../components/sections/Testimonial.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import type { Locale } from "../../i18n/locales";
import { reveal } from "../../lib/motion";
import { displayText } from "../../lib/typography";
import { ritualsContent } from "./rituals.content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { offerings } = ritualsContent[locale];
const { ritualOfBeing, inDivineCompany } = offerings;
---

<section id="formas" class="bg-lavender text-ink">
  <div class="py-18 md:pt-26 md:pb-14">
    <Grid startOnMobile class="items-end gap-y-10">
      <SectionLabel class="col-span-full border-ink/25 text-ink-soft" />
      <h2
        data-reveal
        class:list={[
          "col-span-full m-0 text-40 leading-104 md:col-span-8 md:col-start-1 md:text-72 md:leading-098",
          displayText,
          reveal,
        ]}
      >
        {offerings.title}
      </h2>
    </Grid>
  </div>
  <Grid startOnMobile class="items-stretch gap-y-6 pb-32">
    <ServiceCard
      id="the-ritual-of-being"
      {...ritualOfBeing}
      taglineItalic
      cta={{
        label: ritualOfBeing.cta,
        href: "#the-ritual-of-being",
        variant: "outline-cream",
      }}
      class="min-h-130 bg-aubergine md:col-span-6 md:col-start-1"
      copyWidthClass="max-w-120"
    />
    <ServiceCard
      id="in-divine-company"
      {...inDivineCompany}
      taglineItalic
      cta={{
        label: inDivineCompany.cta,
        href: "#in-divine-company",
        variant: "cream",
      }}
      class="min-h-130 bg-plum delay-150 md:col-span-6 md:col-start-7"
      copyWidthClass="max-w-120"
    />
  </Grid>
  <Testimonial {...offerings.testimonial} quoteClass="text-aubergine" />
</section>
