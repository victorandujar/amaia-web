---
import InnerClosing from "../../components/sections/InnerClosing.astro";
import InnerHero from "../../components/sections/InnerHero.astro";
import ImagePlaceholder from "../../components/ui/ImagePlaceholder.astro";
import type { Locale } from "../../i18n/locales";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { links } from "../../lib/links";
import { grain } from "../../lib/texture";
import GazeSection from "./GazeSection.astro";
import IntroSection from "./IntroSection.astro";
import LanguagesSection from "./LanguagesSection.astro";
import OfferingsSection from "./OfferingsSection.astro";
import { ritualsContent } from "./rituals.content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { meta, hero, closing } = ritualsContent[locale];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  locale={locale}
  class="bg-aubergine"
>
  <main class="flex min-h-screen w-full flex-col bg-lavender text-ink">
    <InnerHero
      locale={locale}
      page="rituals"
      title={hero.title}
      tone="light"
      startWord={hero.startWord}
      endWord={hero.endWord}
      class="bg-aubergine text-cream md:gap-8"
      wordsClass="text-64 md:text-144"
      endWordClass="md:mb-7"
    >
      <ImagePlaceholder
        as="span"
        label={hero.placeholder.label}
        tag={hero.placeholder.tag}
        description={hero.placeholder.description}
        class:list={[
          "aspect-3/4 bg-plum-veil p-6 font-sans tracking-normal",
          grain,
        ]}
        tagClass="text-cream/90"
        descriptionClass="text-16 leading-145 text-cream"
      />
    </InnerHero>
    <IntroSection locale={locale} />
    <GazeSection locale={locale} />
    <LanguagesSection locale={locale} />
    <OfferingsSection locale={locale} />
    <InnerClosing
      locale={locale}
      title={closing.title}
      body={closing.body}
      cta={{ label: closing.cta, href: links.contact }}
      next={{ page: "about", title: closing.next }}
      class="bg-aubergine"
    />
  </main>
</BaseLayout>
