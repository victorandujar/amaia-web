---
import Grid from "../../components/layout/Grid.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import type { Locale } from "../../i18n/locales";
import { reveal } from "../../lib/motion";
import { displayText } from "../../lib/typography";
import { studioContent } from "./studio.content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { craft } = studioContent[locale];
const stepPlacement = [
  "md:col-start-1 delay-0",
  "md:col-start-5 delay-150",
  "md:col-start-9 delay-300",
];
---

<section id="manera" class="bg-ivory py-18 text-ink md:py-26">
  <Grid startOnMobile class="items-end gap-y-10">
    <SectionLabel class="col-span-full border-ink/25 text-ink-soft" />
    <h2
      data-reveal
      class:list={[
        "col-span-full m-0 text-40 leading-104 md:col-span-7 md:col-start-1 md:text-72 md:leading-098",
        displayText,
        reveal,
      ]}
    >
      {craft.title}
    </h2>
    <p
      data-reveal
      class:list={[
        "col-span-full m-0 text-17 leading-160 md:col-span-5 md:col-start-8 md:text-18",
        reveal,
      ]}
    >
      {craft.body}
    </p>
    {craft.steps.map((step, index) => (
      <div
        data-reveal
        class:list={[
          "col-span-full mt-10 flex flex-col gap-3.5 border-t border-ink/25 pt-4 md:col-span-4",
          reveal,
          stepPlacement[index],
        ]}
      >
        <h3 class="m-0 font-display text-28 leading-105 font-light tracking-snug text-eucalyptus md:text-36">
          {step.title}
        </h3>
        <p class="m-0 max-w-95 text-17 leading-155 text-ink-soft md:text-16">
          {step.body}
        </p>
      </div>
    ))}
  </Grid>
</section>
