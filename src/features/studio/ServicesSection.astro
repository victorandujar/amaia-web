---
import Grid from "../../components/layout/Grid.astro";
import ServiceCard from "../../components/sections/ServiceCard.astro";
import Testimonial from "../../components/sections/Testimonial.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import type { Locale } from "../../i18n/locales";
import { links } from "../../lib/links";
import { reveal } from "../../lib/motion";
import { displayText } from "../../lib/typography";
import { studioContent } from "./studio.content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { services } = studioContent[locale];
const { mysteryOfForm, creativeCorrespondences } = services;
---

<section id="servicios" class="bg-ivory text-ink">
  <div class="py-18 md:pt-26 md:pb-14">
    <Grid startOnMobile class="items-end gap-y-10">
      <SectionLabel
        text={services.label}
        class="col-span-full border-ink/25 text-ink-soft"
      />
      <h2
        data-reveal
        class:list={[
          "col-span-full m-0 text-40 leading-104 md:col-span-7 md:col-start-1 md:text-72 md:leading-098",
          displayText,
          reveal,
        ]}
      >
        {services.title}
      </h2>
      <p
        data-reveal
        class:list={[
          "col-span-full m-0 text-17 leading-160 md:col-span-5 md:col-start-8 md:text-18",
          reveal,
        ]}
      >
        {services.body}
      </p>
    </Grid>
  </div>
  <Grid startOnMobile class="items-stretch gap-y-6 pb-32">
    <ServiceCard
      id="mystery-of-form"
      {...mysteryOfForm}
      cta={{
        label: mysteryOfForm.cta,
        href: "#mystery-of-form",
        variant: "outline-cream",
      }}
      class="min-h-140 bg-eucalyptus md:col-span-6 md:col-start-1"
      labelClass="mb-2"
      copyWidthClass="max-w-115"
    />
    <ServiceCard
      id="creative-correspondences"
      {...creativeCorrespondences}
      cta={{
        label: creativeCorrespondences.cta,
        href: links.contact,
        variant: "cream",
      }}
      class="min-h-140 bg-plum delay-150 md:col-span-6 md:col-start-7"
      copyWidthClass="max-w-115"
    />
  </Grid>
  <Testimonial {...services.testimonial} quoteClass="text-eucalyptus" />
</section>
