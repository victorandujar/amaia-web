---
import { Image } from "astro:assets";
import heroImage from "../../assets/images/studio-hero-laptop.jpg";
import InnerClosing from "../../components/sections/InnerClosing.astro";
import InnerHero from "../../components/sections/InnerHero.astro";
import type { Locale } from "../../i18n/locales";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { whatsappLink } from "../../lib/links";
import { serviceNode } from "../../lib/structured-data";
import { grain } from "../../lib/texture";
import CraftSection from "./CraftSection.astro";
import ServicesSection from "./ServicesSection.astro";
import WelcomeSection from "./WelcomeSection.astro";
import { studioContent } from "./studio.content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { meta, hero, closing, services } = studioContent[locale];
const site = Astro.site;
const offerings = [
  { id: "mystery-of-form", service: services.mysteryOfForm },
  { id: "creative-correspondences", service: services.creativeCorrespondences },
];
const structuredData = site
  ? offerings.map(({ id, service }) =>
      serviceNode(site, locale, "studio", {
        id,
        name: service.title,
        serviceType: service.label,
        description: service.paragraphs.join(" "),
      }),
    )
  : [];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  locale={locale}
  page="studio"
  image={{ src: heroImage, alt: hero.imageAlt }}
  structuredData={structuredData}
  class="bg-eucalyptus"
>
  <main class="flex min-h-screen w-full flex-col bg-ivory text-ink">
    <InnerHero
      locale={locale}
      page="studio"
      tone="light"
      title={hero.title}
      startWord={hero.startWord}
      endWord={hero.endWord}
      class="bg-eucalyptus text-cream md:gap-8"
      wordsClass="text-64 md:text-144"
    >
      <span class:list={["block overflow-hidden", grain]}>
        <Image
          src={heroImage}
          alt={hero.imageAlt}
          widths={[432, 864]}
          sizes="(max-width: 760px) 78vw, 432px"
          loading="eager"
          fetchpriority="high"
          class="block aspect-3/4 w-full object-cover saturate-85"
        />
      </span>
    </InnerHero>
    <WelcomeSection locale={locale} />
    <CraftSection locale={locale} />
    <ServicesSection locale={locale} />
    <InnerClosing
      locale={locale}
      title={closing.title}
      body={closing.body}
      cta={{ label: closing.cta, href: whatsappLink(locale, "firstListening") }}
      next={{ page: "rituals", title: closing.next }}
      class="bg-eucalyptus"
    />
  </main>
</BaseLayout>
