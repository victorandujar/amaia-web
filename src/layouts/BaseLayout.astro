---
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource-variable/schibsted-grotesk/wght.css";
import newsreaderLatin from "@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url";
import schibstedLatin from "@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url";
import type { ImageMetadata } from "astro";
import SeoHead from "../components/seo/SeoHead.astro";
import "../styles/global.css";
import type { Locale } from "../i18n/locales";
import type { PageKey } from "../i18n/routes";
import type { JsonLdNode } from "../lib/structured-data";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  page: PageKey;
  /** Picture shown when the page is shared. */
  image: { src: ImageMetadata; alt: string };
  /** Page-specific schema.org entities, added to the shared graph. */
  structuredData?: readonly JsonLdNode[];
  /** Page background, visible on overscroll. */
  class?: string;
}

const {
  title,
  description,
  locale,
  page,
  image,
  structuredData,
  class: className,
} = Astro.props;
---

<!doctype html>
<html
  lang={locale}
  class="[&.intro]:overflow-hidden [&.menu-open]:overflow-hidden"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The two fonts every page paints first (latin subset), fetched before the CSS asks for them. */}
    <link
      rel="preload"
      href={newsreaderLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={schibstedLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SeoHead
      title={title}
      description={description}
      locale={locale}
      page={page}
      image={image}
      {...(structuredData ? { structuredData } : {})}
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <slot name="head" />
  </head>
  <body
    class:list={[
      "font-sans leading-[normal] text-ink [&_:is(h1,h2,h3)]:text-balance [&_a:hover]:opacity-75 [&_p]:text-pretty",
      className,
    ]}
  >
    <slot />
    <script>
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.setAttribute("data-inview", "");
            revealObserver.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );

      for (const element of document.querySelectorAll("[data-reveal]")) {
        revealObserver.observe(element);
      }
    </script>
  </body>
</html>
